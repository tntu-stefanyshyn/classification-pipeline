MONGODB_URI=mongodb://localhost:27017/app
JWT_SECRET=change-me

# AWS S3 configuration (fill with your values)
AWS_S3_BUCKET=your-bucket
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: seconds for presigned URL expiry
AWS_S3_PRESIGN_EXPIRES=900

# Local mode (default): the backend runs compute containers via Docker; no AWS Batch needed.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are only needed for S3 uploads.
BACKEND_CLOUD_WORKER_ENABLED=false
BACKEND_LOCAL_WORKER_ENABLED=true
# Secret the compute containers send to read experiments and files; set any long random string.
BACKEND_SERVICE_TOKEN=change-me-service-token
BACKEND_LOCAL_DOCKER_IMAGE=aws-jobs
LOCAL_WORKER_POLL_MS=3000
AWS_BATCH_JOB_QUEUE=your-batch-queue
AWS_BATCH_JOB_DEFINITION=your-job-definition
AWS_BATCH_JOB_NAME_PREFIX=experiment-run
CLOUD_WORKER_POLL_MS=5000
AWS_COMPUTATION_RESULTS_BUCKET=your-results-bucket
AWS_COMPUTATION_RESULTS_PREFIX=computations
AWS_COMPUTATION_RESULTS_REGION=eu-central-1
