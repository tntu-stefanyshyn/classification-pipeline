# Every variable is described in docs/operations/configuration.md. The backend checks them at
# startup and stops with a list of problems if a required value is missing or invalid.

# development (default) or production. Production refuses the placeholder secrets below.
# NODE_ENV=development

# Required. Docker Compose overrides it with mongodb://mongo:27017/app.
MONGODB_URI=mongodb://localhost:27017/app

# Required in production: a long random string. Signs access tokens, refresh tokens and upload keys.
JWT_SECRET=change-me
# Session lifetimes: seconds, or a number with s, m, h or d. See docs/api/authentication.md.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Browser origins allowed to call the API (comma-separated). The default covers the desktop app:
# its Vite dev server and `null`, the origin of the packaged app. See docs/api/index.md#cors.
# CORS_ORIGINS=http://localhost:5173,null

# AWS S3 configuration for dataset files (fill with your values)
AWS_S3_BUCKET=your-bucket
AWS_REGION=eu-central-1
# Optional: leave empty to use the AWS SDK default credentials (for example an IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: seconds for presigned URL expiry (1 to 604800)
AWS_S3_PRESIGN_EXPIRES=900

# Local mode (default): the backend runs compute containers via Docker; no AWS Batch needed.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are only needed for S3 uploads.
BACKEND_CLOUD_WORKER_ENABLED=false
BACKEND_LOCAL_WORKER_ENABLED=true
# Secret the workers and compute containers authenticate with; set any long random string.
# The desktop worker needs the same value (desktop/.env). See docs/api/authentication.md.
BACKEND_SERVICE_TOKEN=change-me-service-token
# Optional: URL by which the containers started by the backend reach it.
# BACKEND_GRAPHQL_URL=http://host.docker.internal:4000/graphql
# Optional: Docker images of the compute and the optimization containers.
BACKEND_LOCAL_DOCKER_IMAGE=aws-jobs
# OPTIMIZATION_DOCKER_IMAGE=aws-jobs-optimization
# Optional: path of the aws-jobs directory used to build the image when it is missing.
# AWS_JOBS_DIR=../aws-jobs
# Optional: poll intervals in milliseconds of the backend Docker worker and the AWS Batch worker.
LOCAL_WORKER_POLL_MS=3000
CLOUD_WORKER_POLL_MS=5000

# AWS Batch (only with BACKEND_CLOUD_WORKER_ENABLED=true). See docs/operations/aws-batch.md.
AWS_BATCH_JOB_QUEUE=your-batch-queue
AWS_BATCH_JOB_DEFINITION=your-job-definition
# Optional: prefix of the submitted job names.
AWS_BATCH_JOB_NAME_PREFIX=experiment-run
# Optional: AWS_COMPUTATION_RESULTS_BUCKET falls back to AWS_S3_BUCKET, the region to AWS_REGION.
AWS_COMPUTATION_RESULTS_BUCKET=your-results-bucket
AWS_COMPUTATION_RESULTS_PREFIX=computations
AWS_COMPUTATION_RESULTS_REGION=eu-central-1
