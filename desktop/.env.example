# Read by the Electron main process in development. A packaged app takes these from the environment.
# Must equal BACKEND_SERVICE_TOKEN in backend/.env: the local queue worker authenticates with it.
BACKEND_SERVICE_TOKEN=change-me-service-token
# Optional switches of the desktop worker (see docs/operations/configuration.md):
# LOCAL_WORKER_ENABLED=false          # start the desktop without its worker
# LOCAL_WORKER_POLL_MS=3000           # how often it looks for a queued local run
# LOCAL_WORKER_STATUS_POLL_MS=3000    # how often it checks that its run was not stopped
# LOCAL_WORKER_REBUILD_IMAGE=false    # build the aws-jobs image only when it is missing
# AWS_JOBS_DIR=../aws-jobs            # directory used to build that image
