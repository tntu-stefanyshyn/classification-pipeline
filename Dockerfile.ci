FROM node:24-bookworm-slim

# MongoDB backs the run-claiming concurrency test (backend/src/modules/computations/ClaimConcurrency.mongo.test.ts).
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates curl gnupg \
    && curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc \
        | gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg] http://repo.mongodb.org/apt/debian bookworm/mongodb-org/7.0 main" \
        > /etc/apt/sources.list.d/mongodb-org-7.0.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends mongodb-org-server \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/test-venv

ENV PATH="/opt/test-venv/bin:${PATH}" \
    PUPPETEER_SKIP_DOWNLOAD=true \
    MONGODB_TEST_URI=mongodb://127.0.0.1:27017

WORKDIR /app
COPY . .
RUN python3 -m pip install --no-cache-dir -e './aws-jobs[dev]' \
    && npm ci --no-audit --no-fund

CMD ["sh", "-c", "mkdir -p /tmp/mongodb && mongod --dbpath /tmp/mongodb --bind_ip 127.0.0.1 --fork --logpath /tmp/mongod.log && npm test"]
